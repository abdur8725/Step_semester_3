#include <iostream>
#include <vector>
using namespace std;

pair<int, int> busiestRow(vector<vector<int>>& grid) {
    int bestRow = 0;
    int maxTotal = -1;

    for (int i = 0; i < grid.size(); i++) {
        int total = 0;

        for (int j = 0; j < grid[i].size(); j++) {
            total += grid[i][j];
        }

        if (total > maxTotal) {
            maxTotal = total;
            bestRow = i;
        }
    }

    return {bestRow, maxTotal};
}

int main() {
    int r, c;
    cin >> r >> c;

    vector<vector<int>> grid(r, vector<int>(c));

    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++) {
            cin >> grid[i][j];
        }
    }

    pair<int, int> result = busiestRow(grid);

    cout << "Row " << result.first
         << ", Total " << result.second << endl;

    return 0;
}

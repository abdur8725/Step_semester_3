
#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int countInBand(vector<int>& scores, int low, int high) {
    int first = lower_bound(scores.begin(), scores.end(), low) - scores.begin();
    int last = upper_bound(scores.begin(), scores.end(), high) - scores.begin();

    return last - first;
}

int main() {
    int n;
    cin >> n;

    vector<int> scores(n);

    for (int i = 0; i < n; i++) {
        cin >> scores[i];
    }

    int low, high;
    cin >> low >> high;

    cout << countInBand(scores, low, high) << endl;

    return 0;
}

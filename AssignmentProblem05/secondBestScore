
#include <iostream>
#include <vector>
using namespace std;

int secondHighest(vector<int>& scores) {
    int highest = -1;
    int second = -1;

    for (int score : scores) {
        if (score > highest) {
            second = highest;
            highest = score;
        } else if (score < highest && score > second) {
            second = score;
        }
    }

    return second;
}

int main() {
    int n;
    cin >> n;

    vector<int> scores(n);

    for (int i = 0; i < n; i++) {
        cin >> scores[i];
    }

    cout << secondHighest(scores) << endl;

    return 0;
}

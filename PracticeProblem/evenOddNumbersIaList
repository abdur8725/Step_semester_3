
#include <iostream>
#include <vector>
using namespace std;

int main() {
    int n;
    cin >> n;

    vector<int> numbers(n);
    int even = 0, odd = 0;

    for (int i = 0; i < n; i++) {
        cin >> numbers[i];

        if (numbers[i] % 2 == 0) {
            even++;
        } else {
            odd++;
        }
    }

    cout << "Even: " << even << endl;
    cout << "Odd: " << odd << endl;

    return 0;
}

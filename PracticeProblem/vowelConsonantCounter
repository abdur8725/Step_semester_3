#include <iostream>
#include <string>
using namespace std;

int main() {
    string word;
    cin >> word;

    int vowels = 0, consonants = 0;

    for (char ch : word) {
        ch = tolower(ch);

        if (ch == 'a' || ch == 'e' || ch == 'i' ||
            ch == 'o' || ch == 'u') {
            vowels++;
        } else {
            consonants++;
        }
    }

    cout << "Vowels: " << vowels << endl;
    cout << "Consonants: " << consonants << endl;

    return 0;
}
